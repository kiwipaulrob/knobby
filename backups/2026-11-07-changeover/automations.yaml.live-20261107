- id: knob_2_rotary_control
  alias: Knob 2 rotary control (HOBEIAN ZG-101ZD)
  triggers:
    - trigger: mqtt
      topic: zigbee2mqtt/knob 2/action
  variables:
    event_map:
      rotate_right: rotate_right
      rotate_left: rotate_left
      single: press
      double: rotate_right_pressed
      brightness_step_up: rotate_right
      brightness_step_down: rotate_left
      toggle: press
      color_temperature_step_down: seek_back
      color_temperature_step_up: seek_fwd
  conditions:
    - condition: template
      value_template: "{{ trigger.payload in event_map }}"
  actions:
    - action: rest_command.ma_dimmer
      data:
        event_type: >
          {% set h = state_attr('automation.knob_2_hold_for_favourite_hobeian_zg_101zd','last_triggered') %}
          {% set seeking = h is not none and (now() - h).total_seconds() < 2 %}
          {% if seeking and trigger.payload == 'rotate_right' %}seek_fwd
          {% elif seeking and trigger.payload == 'rotate_left' %}seek_back
          {% else %}{{ event_map[trigger.payload] }}{% endif %}
        steps: 1
  mode: queued
  max: 10
- id: knob_2_hold_fav
  alias: Knob 2 hold for favourite (HOBEIAN ZG-101ZD)
  triggers:
    - trigger: mqtt
      topic: zigbee2mqtt/knob 2/action
      payload: hue_move
    - trigger: mqtt
      topic: zigbee2mqtt/knob 2/action
      payload: hold
  conditions:
    - condition: template
      value_template: >
        {{ state_attr('automation.knob_2_hold_for_favourite_hobeian_zg_101zd','last_triggered') is none
          or (now() - state_attr('automation.knob_2_hold_for_favourite_hobeian_zg_101zd','last_triggered')).total_seconds() > 10 }}
  actions:
    - delay: "00:00:02"
    - condition: template
      value_template: >
        {% set r = state_attr('automation.knob_2_rotary_control_hobeian_zg_101zd','last_triggered') %}
        {% set h = state_attr('automation.knob_2_hold_for_favourite_hobeian_zg_101zd','last_triggered') %}
        {{ r is none or h is none or (r < h - timedelta(seconds=1)) }}
    - action: rest_command.ma_dimmer
      data:
        event_type: long_press
        steps: 1
  mode: single
- id: knob_2_triple_click_proxy
  alias: Knob 2 triple-click for previous track (dual-edge mode-flip detect)
  description: Triple-press emits no MQTT action but toggles operation_mode
    event<->command. Firing on BOTH select edges gives a reliable triple-click
    (previous track) from either mode; remote mode-set does not land on this
    firmware so no restore is attempted. Added 7 Nov 2026.
  triggers:
    - trigger: state
      entity_id: select.knob_2_operation_mode
      from: event
      to: command
      id: triple
    - trigger: state
      entity_id: select.knob_2_operation_mode
      from: command
      to: event
      id: triple_rev
  conditions: []
  actions:
    - action: rest_command.ma_dimmer
      data:
        event_type: rotate_left_pressed
        steps: 1
    - delay: "00:00:02"
    - action: rest_command.ma_dimmer
      data:
        event_type: rotate_left_pressed
        steps: 1
  mode: single
