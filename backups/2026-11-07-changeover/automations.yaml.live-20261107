- id: garage_door_status
  triggers:
  - entity_id: sensor.garage_door_level_z
    trigger: state
  actions:
  - target:
      entity_id: input_number.previous_garage_door_angle
    data:
      value: '{{ [90, [0, current_angle | int | abs] | max] | min }}'
    action: input_number.set_value
  - target:
      entity_id: input_text.garage_door_status
    data:
      value: "{% if moving and now - last_update <= movement_timeout %}\n  {% if current_angle\
        \ > previous_angle %} Opening\n  {% elif current_angle < previous_angle %}\
        \ Closing\n  {% else %} Partially Open {% endif %}\n{% elif current_angle\
        \ < closed_angle %} Closed {% elif current_angle > open_angle %} Open {% elif\
        \ closed_angle <= current_angle <= open_angle %} Partially Open {% else %}\
        \ Unknown {% endif %}"
    action: input_text.set_value
  variables:
    current_angle: '{{ states(''sensor.garage_door_level_z'') | int(default=0) }}'
    previous_angle: '{{ states(''input_number.previous_garage_door_angle'') | int(default=current_angle)
      }}'
    moving: '{{ is_state(''binary_sensor.garage_door_level_tilt'', ''on'') | default(false)
      }}'
    last_update: '{{ as_timestamp(states.sensor.garage_door_level_z.last_updated)
      }}'
    now: '{{ as_timestamp(now()) }}'
    closed_angle: 4
    open_angle: 60
    movement_timeout: 6
